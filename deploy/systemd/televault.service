[Unit]
Description=TeleVault Modern Web Dashboard & Telegram Downloader
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=madhu
Group=madhu
WorkingDirectory=/opt/televault
EnvironmentFile=-/opt/televault/.env
Environment="TELEVAULT_HEADLESS=1"
Environment="TELEVAULT_ALLOWED_HOSTS=televault.madhudadi.in"
Environment="TELEVAULT_PORT=8200"
Environment="TELEVAULT_BIND_HOST=127.0.0.1"
ExecStart=/opt/televault/venv/bin/python run_web.py
Restart=always
RestartSec=3
KillMode=process
TimeoutStopSec=15

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
