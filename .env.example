# ==============================================================================
# Telegram MTProto API Credentials
# Obtain your api_id and api_hash at https://my.telegram.org (API development tools)
# ==============================================================================
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_PHONE=+15551234567

# Path to the Telegram MTProto session file
# Default in Docker: /app/session/telegram.session
# Default locally: session/telegram.session
TG_SESSION=session/telegram.session

# ==============================================================================
# TeleVault Server & Web Dashboard Configuration
# ==============================================================================
# Optional static authorization token for web dashboard and API endpoints.
# If omitted or blank, TeleVault generates a secure 32-byte URL-safe ephemeral token on startup.
TELEVAULT_TOKEN=your_secure_random_token_here

# TeleVault internal listen port
# Default in container: 8000 (mapped to host 127.0.0.1:8200 in docker-compose.yml)
# Default locally / bare-metal: 8000 (or 8200 when running directly behind Nginx)
TELEVAULT_PORT=8000

# TeleVault listen address
# Use 0.0.0.0 in Docker container deployments
# Use 127.0.0.1 for local/bare-metal deployments behind reverse proxy
TELEVAULT_BIND_HOST=127.0.0.1

# Allowed Host / Origin header domain names (comma-separated)
# Used for DNS rebinding protection and WebSocket origin verification
TELEVAULT_ALLOWED_HOSTS=televault.madhudadi.in,localhost,127.0.0.1

# Trusted upstream reverse proxy IP addresses / CIDRs for proxy headers (X-Forwarded-For)
TELEVAULT_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,*

# Headless server mode (1 = do not automatically launch local browser on startup)
TELEVAULT_HEADLESS=1

# Output directory for downloaded media files, logs, and SQLite manifest database
# Default in Docker: /app/out
# Default locally: out
TELEVAULT_OUT_DIR=out
